# Google Maps JavaScript API key.
# NOTE: Vite embeds this into the client-side bundle at build time —
# this is NOT a secret storage mechanism, it just saves you from
# pasting the key into the UI every time. Restrict this key in
# Google Cloud Console with HTTP referrer restrictions + API restrictions
# (Maps JavaScript API, Directions API, Places API).
# Restart `npm run dev` after changing this file.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
