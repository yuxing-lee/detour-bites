# Google Maps JavaScript API key.
# NOTE: Vite embeds this into the client-side bundle at build time —
# this is NOT a secret storage mechanism, it just saves you from
# pasting the key into the UI every time. Restrict this key in
# Google Cloud Console with HTTP referrer restrictions + API restrictions
# (Maps JavaScript API, Directions API, Places API).
# Restart `npm run dev` after changing this file.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Gemini API key (optional). Enables two AI features: review summaries on
# each restaurant card, and natural-language parsing of the keyword field
# ("便宜、現在有開" -> keyword + filters). Leave empty to disable both —
# the app works fully without it.
# Same NOT-a-secret caveat as above: this also gets embedded into the
# client bundle. Restrict it in Google Cloud Console (Credentials page)
# with HTTP referrer restrictions + API restrictions limited to the
# "Generative Language API", and consider a low quota / dedicated key
# since Gemini keys don't have Maps-style built-in abuse protection.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
